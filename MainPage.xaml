<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="SentryAssistant.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:SentryAssistant.Models"
    Background="{ThemeResource SentryBackgroundBrush}">

    <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WindowWidthStates">
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1120" /></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RailColumn.Width" Value="248" />
                        <Setter Target="InspectorColumn.Width" Value="286" />
                        <Setter Target="RightInspectorBorder.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="MediumLayout">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="760" /></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RailColumn.Width" Value="220" />
                        <Setter Target="InspectorColumn.Width" Value="0" />
                        <Setter Target="RightInspectorBorder.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="CompactLayout">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="RailColumn.Width" Value="70" />
                        <Setter Target="InspectorColumn.Width" Value="0" />
                        <Setter Target="RightInspectorBorder.Visibility" Value="Collapsed" />
                        <Setter Target="ProfileDetails.Visibility" Value="Collapsed" />
                        <Setter Target="NewWorkLabel.Visibility" Value="Collapsed" />
                        <Setter Target="AssistantNavLabel.Visibility" Value="Collapsed" />
                        <Setter Target="WatcherNavLabel.Visibility" Value="Collapsed" />
                        <Setter Target="ActivityNavLabel.Visibility" Value="Collapsed" />
                        <Setter Target="SettingsNavLabel.Visibility" Value="Collapsed" />
                        <Setter Target="PetStatusText.Visibility" Value="Collapsed" />
                        <Setter Target="ActiveContextPanel.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <VisualStateGroup x:Name="AssistantLifecycleStates">
                <VisualState x:Name="Idle">
                    <VisualState.Setters>
                        <Setter Target="StatusDot.Fill" Value="{ThemeResource SentryAccentBrush}" />
                        <Setter Target="WorkingPulse.Opacity" Value="0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Working">
                    <VisualState.Setters>
                        <Setter Target="StatusDot.Fill" Value="{ThemeResource SentryWarningBrush}" />
                    </VisualState.Setters>
                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                        <DoubleAnimation Storyboard.TargetName="WorkingPulse" Storyboard.TargetProperty="Opacity"
                                         From="0.15" To="0.72" Duration="0:0:0.7" />
                    </Storyboard>
                </VisualState>
                <VisualState x:Name="Resolved">
                    <VisualState.Setters>
                        <Setter Target="StatusDot.Fill" Value="{ThemeResource SentrySuccessBrush}" />
                        <Setter Target="WorkingPulse.Opacity" Value="0" />
                    </VisualState.Setters>
                    <Storyboard>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="StatusDotScale" Storyboard.TargetProperty="ScaleX">
                            <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                            <EasingDoubleKeyFrame KeyTime="0:0:0.18" Value="1.8" />
                            <EasingDoubleKeyFrame KeyTime="0:0:0.48" Value="1" />
                        </DoubleAnimationUsingKeyFrames>
                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="StatusDotScale" Storyboard.TargetProperty="ScaleY">
                            <EasingDoubleKeyFrame KeyTime="0:0:0" Value="1" />
                            <EasingDoubleKeyFrame KeyTime="0:0:0.18" Value="1.8" />
                            <EasingDoubleKeyFrame KeyTime="0:0:0.48" Value="1" />
                        </DoubleAnimationUsingKeyFrames>
                    </Storyboard>
                </VisualState>
                <VisualState x:Name="NeedsInput">
                    <VisualState.Setters>
                        <Setter Target="StatusDot.Fill" Value="{ThemeResource SentryInfoBrush}" />
                        <Setter Target="WorkingPulse.Opacity" Value="0.5" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Faulted">
                    <VisualState.Setters>
                        <Setter Target="StatusDot.Fill" Value="{ThemeResource SentryDangerBrush}" />
                        <Setter Target="WorkingPulse.Opacity" Value="0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <Grid x:Name="RootShell" Background="{ThemeResource SentryBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="RailColumn" Width="248" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="InspectorColumn" Width="286" />
        </Grid.ColumnDefinitions>

        <!-- Workstream rail: compact and task-oriented, intentionally not a stock NavigationView. -->
        <Border Grid.Column="0" Background="{ThemeResource SentryRailBrush}"
                BorderBrush="{ThemeResource SentryBorderBrush}" BorderThickness="0,0,1,0">
            <Grid Padding="10,12,10,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="4,0,4,14" ColumnSpacing="10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="10" Background="{ThemeResource SentryAccentMutedBrush}">
                        <Image Source="Assets/Sentry.png" Width="29" Height="31" Stretch="Uniform" AutomationProperties.Name="Sentry avatar" />
                    </Border>
                    <StackPanel x:Name="ProfileDetails" Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="BRYCE / PERSONAL" Style="{StaticResource SentryMonoMetaTextStyle}" />
                        <TextBlock Text="Sentry Command" FontWeight="SemiBold" Foreground="{ThemeResource SentryTextPrimaryBrush}" />
                    </StackPanel>
                </Grid>

                <Button Grid.Row="1" Margin="0,0,0,14" Height="36" HorizontalAlignment="Stretch"
                        Style="{StaticResource SentryPrimaryButtonStyle}" AutomationProperties.Name="Create a new work order">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <FontIcon Glyph="&#xE710;" FontSize="13" />
                        <TextBlock x:Name="NewWorkLabel" Text="New work order" />
                    </StackPanel>
                </Button>

                <StackPanel Grid.Row="2" Spacing="2">
                    <TextBlock Text="WORKSPACE" Margin="10,0,0,7" Style="{StaticResource SentryEyebrowTextStyle}" />
                    <ToggleButton x:Name="AssistantNavButton" Tag="assistant" IsChecked="True"
                                  Style="{StaticResource SentryNavButtonStyle}" Click="Navigate_Click"
                                  AutomationProperties.Name="Assistant">
                        <StackPanel Orientation="Horizontal" Spacing="11">
                            <FontIcon Glyph="&#xE8BD;" FontSize="15" Width="16" />
                            <TextBlock x:Name="AssistantNavLabel" Text="Assistant" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="WatcherNavButton" Tag="watcher"
                                  Style="{StaticResource SentryNavButtonStyle}" Click="Navigate_Click"
                                  AutomationProperties.Name="Code watcher">
                        <StackPanel Orientation="Horizontal" Spacing="11">
                            <FontIcon Glyph="&#xEC50;" FontSize="15" Width="16" />
                            <TextBlock x:Name="WatcherNavLabel" Text="Code watcher" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="ActivityNavButton" Tag="activity"
                                  Style="{StaticResource SentryNavButtonStyle}" Click="Navigate_Click"
                                  AutomationProperties.Name="Activity">
                        <StackPanel Orientation="Horizontal" Spacing="11">
                            <FontIcon Glyph="&#xE9D9;" FontSize="15" Width="16" />
                            <TextBlock x:Name="ActivityNavLabel" Text="Activity" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>

                    <Border Height="1" Margin="8,13,8,12" Background="{ThemeResource SentryBorderBrush}" />
                    <TextBlock Text="RECENT" Margin="10,0,0,7" Style="{StaticResource SentryEyebrowTextStyle}" />
                    <Border Padding="10,8" CornerRadius="10" Background="{ThemeResource SentrySurfaceBrush}">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Sentry foundation" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="25vid/sentry-foundation" Style="{StaticResource SentryMonoMetaTextStyle}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Row="3" Spacing="8">
                    <ToggleButton x:Name="SettingsNavButton" Tag="settings"
                                  Style="{StaticResource SentryNavButtonStyle}" Click="Navigate_Click"
                                  AutomationProperties.Name="Settings">
                        <StackPanel Orientation="Horizontal" Spacing="11">
                            <FontIcon Glyph="&#xE713;" FontSize="15" Width="16" />
                            <TextBlock x:Name="SettingsNavLabel" Text="Settings" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton>
                    <Border Padding="9,8" CornerRadius="10" BorderBrush="{ThemeResource SentryBorderBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <Ellipse Width="7" Height="7" Fill="{ThemeResource SentrySuccessBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="PetStatusText" Text="Sentry pet active" Style="{StaticResource SentryMonoMetaTextStyle}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Focused command canvas. -->
        <Grid Grid.Column="1" MinWidth="420">
            <Grid.RowDefinitions><RowDefinition Height="58" /><RowDefinition Height="*" /></Grid.RowDefinitions>

            <Border BorderBrush="{ThemeResource SentryBorderBrush}" BorderThickness="0,0,0,1" Padding="22,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="CurrentPageTitle" Text="Assistant" FontWeight="SemiBold" FontSize="15" />
                        <TextBlock Text="Personal profile  /  Sentry foundation" Style="{StaticResource SentryMonoMetaTextStyle}" />
                    </StackPanel>
                    <StackPanel x:Name="ActiveContextPanel" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                        <Border Padding="8,4" CornerRadius="8" Background="{ThemeResource SentrySurfaceBrush}">
                            <TextBlock Text="CODEX" Style="{StaticResource SentryMonoMetaTextStyle}" />
                        </Border>
                        <Border Padding="8,4" CornerRadius="8" Background="{ThemeResource SentrySurfaceBrush}">
                            <TextBlock Text="LOCAL NODE" Style="{StaticResource SentryMonoMetaTextStyle}" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid x:Name="AssistantPage" Padding="22,18,22,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <InfoBar x:Name="AssistantStatus" IsOpen="True" IsClosable="False" Severity="Informational"
                             Title="Ready" Message="Ask Sentry a question or use push-to-talk." />

                    <ListView x:Name="ConversationList" Grid.Row="1" Margin="0,12,0,12"
                              ItemsSource="{x:Bind Messages}" SelectionMode="None"
                              HorizontalContentAlignment="Stretch">
                        <ListView.ItemContainerTransitions>
                            <TransitionCollection><EntranceThemeTransition FromVerticalOffset="18" /></TransitionCollection>
                        </ListView.ItemContainerTransitions>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:AssistantMessage">
                                <Grid MaxWidth="672" Padding="0,6" HorizontalAlignment="Center">
                                    <Border Padding="14,11" CornerRadius="12"
                                            Background="{ThemeResource SentrySurfaceBrush}"
                                            BorderBrush="{ThemeResource SentryBorderBrush}" BorderThickness="1">
                                        <Grid RowSpacing="7">
                                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                            <Grid ColumnSpacing="10">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Speaker}" Style="{StaticResource SentryEyebrowTextStyle}" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind DisplayTime}" Style="{StaticResource SentryMonoMetaTextStyle}" />
                                            </Grid>
                                            <TextBlock Grid.Row="1" Text="{x:Bind Text}" TextWrapping="WrapWholeWords"
                                                       IsTextSelectionEnabled="True" Foreground="{ThemeResource SentryTextPrimaryBrush}" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Border Grid.Row="2" MaxWidth="704" HorizontalAlignment="Center" Padding="10,8,8,8"
                            CornerRadius="14" Background="{ThemeResource SentrySurfaceBrush}"
                            BorderBrush="{ThemeResource SentryBorderStrongBrush}" BorderThickness="1">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="PromptBox" MinHeight="38" MaxHeight="116" PlaceholderText="Message Sentry..."
                                     KeyDown="PromptBox_KeyDown" AutomationProperties.Name="Message to Sentry"
                                     Style="{StaticResource SentryTextBoxStyle}" BorderThickness="0" />
                            <AppBarButton x:Name="RecordButton" Grid.Column="1" Icon="Microphone" Label="Speak"
                                          Click="RecordButton_Click" AutomationProperties.HelpText="Start or stop a voice reply" />
                            <AppBarButton x:Name="SendButton" Grid.Column="2" Icon="Send" Label="Send" Click="SendButton_Click" />
                        </Grid>
                    </Border>
                </Grid>

                <Grid x:Name="WatcherPage" Visibility="Collapsed" Padding="28,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" /><RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Code watcher" Style="{StaticResource SentryPageTitleStyle}" />
                    <TextBlock Grid.Row="1" Margin="0,4,0,16" Text="A quiet local activity stream. Command output stays silent until work resolves."
                               Foreground="{ThemeResource SentryTextSecondaryBrush}" />
                    <Border Grid.Row="2" Padding="10" CornerRadius="12" Background="{ThemeResource SentrySurfaceBrush}"
                            BorderBrush="{ThemeResource SentryBorderBrush}" BorderThickness="1">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="WatchPathBox" PlaceholderText="Folder to watch" AutomationProperties.Name="Code folder to watch"
                                     Style="{StaticResource SentryTextBoxStyle}" />
                            <AppBarButton Grid.Column="1" Icon="Folder" Label="Browse" Click="BrowseFolder_Click" />
                            <AppBarButton x:Name="WatchButton" Grid.Column="2" Icon="Play" Label="Start watching" Click="WatchButton_Click" />
                        </Grid>
                    </Border>
                    <Grid Grid.Row="3" Margin="0,14,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <InfoBar x:Name="WatcherStatus" IsOpen="True" IsClosable="False" Severity="Informational"
                                 Title="Not watching" Message="Choose a folder and start the watcher." />
                        <ListView x:Name="WatcherList" Grid.Row="1" Margin="0,10,0,0" ItemsSource="{x:Bind CodeChanges}" SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:CodeActivity">
                                    <Grid Padding="8,9" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="84" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind Kind}" FontFamily="Cascadia Mono" FontSize="11" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{x:Bind Path}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" Text="{x:Bind DisplayTime}" Style="{StaticResource SentryMonoMetaTextStyle}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Grid>

                <Grid x:Name="ActivityPage" Visibility="Collapsed" Padding="28,24">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <TextBlock Text="Activity" Style="{StaticResource SentryPageTitleStyle}" />
                    <TextBlock Grid.Row="1" Margin="0,4,0,16" Text="Attributable local events and resolution summaries."
                               Foreground="{ThemeResource SentryTextSecondaryBrush}" />
                    <ListView Grid.Row="2" ItemsSource="{x:Bind ActivityLog}" SelectionMode="None" FontFamily="Cascadia Mono" FontSize="12" />
                </Grid>

                <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" Padding="28,24">
                    <StackPanel MaxWidth="820" HorizontalAlignment="Left" Spacing="18">
                        <TextBlock Text="Settings" Style="{StaticResource SentryPageTitleStyle}" />
                        <TextBlock Text="Searchable gateway settings replace direct provider keys in the connected milestone. The local prototype controls remain available here now."
                                   Foreground="{ThemeResource SentryTextSecondaryBrush}" TextWrapping="Wrap" />

                        <Expander Header="Assistant" IsExpanded="True">
                            <StackPanel Padding="0,12,0,6" Spacing="12">
                                <TextBox x:Name="AssistantNameBox" Header="Assistant name" />
                                <TextBox x:Name="AssistantModelBox" Header="Conversation model" />
                                <TextBox x:Name="SummaryModelBox" Header="Summary model" />
                                <NumberBox x:Name="SummaryWordLimitBox" Header="Maximum spoken summary words" Minimum="8" Maximum="40" SpinButtonPlacementMode="Inline" />
                                <ToggleSwitch x:Name="BriefSummaryToggle" Header="One-sentence Jarvis summaries" />
                            </StackPanel>
                        </Expander>

                        <Expander Header="Voice and microphone" IsExpanded="True">
                            <StackPanel Padding="0,12,0,6" Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="18">
                                    <ToggleSwitch x:Name="SpeakToggle" Header="Speak resolutions only" AutomationProperties.Name="Speak resolved assistant replies" />
                                    <ToggleSwitch x:Name="SettingsSpeakToggle" Header="Voice output enabled" />
                                </StackPanel>
                                <ComboBox x:Name="SpeechVoiceBox" Header="OpenAI voice" MinWidth="240">
                                    <ComboBoxItem Content="coral" /><ComboBoxItem Content="marin" /><ComboBoxItem Content="cedar" />
                                    <ComboBoxItem Content="alloy" /><ComboBoxItem Content="ash" /><ComboBoxItem Content="nova" />
                                    <ComboBoxItem Content="onyx" /><ComboBoxItem Content="sage" /><ComboBoxItem Content="shimmer" />
                                </ComboBox>
                                <TextBox x:Name="SpeechModelBox" Header="Speech model" />
                                <TextBox x:Name="TranscriptionModelBox" Header="Transcription model" />
                                <TextBox x:Name="VoiceStyleBox" Header="Voice style" AcceptsReturn="True" TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander>

                        <Expander Header="OpenAI connection" IsExpanded="True">
                            <StackPanel Padding="0,12,0,6" Spacing="12">
                                <PasswordBox x:Name="ApiKeyBox" Header="API key" PlaceholderText="Leave blank to keep the protected key" />
                                <TextBlock x:Name="ApiKeyStatusText" Text="Checking protected API key..." />
                                <Button Content="Test connection" HorizontalAlignment="Left" Click="TestConnection_Click" />
                            </StackPanel>
                        </Expander>

                        <Expander Header="Code watcher" IsExpanded="True">
                            <StackPanel Padding="0,12,0,6" Spacing="12">
                                <TextBox x:Name="SettingsWatchPathBox" Header="Default watched folder" />
                                <ToggleSwitch x:Name="NotifyChangesToggle" Header="Show code change activity" />
                            </StackPanel>
                        </Expander>

                        <Button Content="Save all settings" HorizontalAlignment="Left" Style="{StaticResource SentryPrimaryButtonStyle}" Click="SaveSettings_Click" />
                        <InfoBar x:Name="SettingsStatus" IsOpen="False" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Evidence and node inspector. -->
        <Border x:Name="RightInspectorBorder" Grid.Column="2" Background="{ThemeResource SentryRailBrush}"
                BorderBrush="{ThemeResource SentryBorderBrush}" BorderThickness="1,0,0,0">
            <ScrollViewer Padding="16,18">
                <StackPanel Spacing="16">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="SENTRY STATUS" Style="{StaticResource SentryEyebrowTextStyle}" />
                            <TextBlock Text="Execution boundary" FontSize="15" FontWeight="SemiBold" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource SentryIconButtonStyle}" Click="OpenSettings_Click"
                                AutomationProperties.Name="Open settings">
                            <FontIcon Glyph="&#xE713;" FontSize="14" />
                        </Button>
                    </Grid>

                    <Border x:Name="AssistantStatePanel" Padding="12" CornerRadius="12"
                            Background="{ThemeResource SentrySurfaceBrush}" BorderBrush="{ThemeResource SentryBorderBrush}" BorderThickness="1">
                        <Grid ColumnSpacing="11">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid Width="30" Height="30">
                                <Border x:Name="WorkingPulse" Width="28" Height="28" CornerRadius="14" Opacity="0"
                                        BorderBrush="{ThemeResource SentryWarningBrush}" BorderThickness="1" />
                                <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{ThemeResource SentryAccentBrush}"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform><ScaleTransform x:Name="StatusDotScale" ScaleX="1" ScaleY="1" /></Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock x:Name="AssistantStateText" Text="READY" Style="{StaticResource SentryMonoMetaTextStyle}" />
                                <TextBlock x:Name="AssistantStateDetail" Text="Awaiting work order" FontSize="12" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Spacing="7">
                        <TextBlock Text="CONTROL PLANE" Style="{StaticResource SentryEyebrowTextStyle}" />
                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Gateway" /><TextBlock Grid.Column="1" Text="LOCAL" Foreground="{ThemeResource SentryWarningBrush}" Style="{StaticResource SentryMonoMetaTextStyle}" />
                        </Grid>
                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Hermes runtime" /><TextBlock Grid.Column="1" Text="PLANNED" Style="{StaticResource SentryMonoMetaTextStyle}" />
                        </Grid>
                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Windows node" /><TextBlock Grid.Column="1" Text="ONLINE" Foreground="{ThemeResource SentrySuccessBrush}" Style="{StaticResource SentryMonoMetaTextStyle}" />
                        </Grid>
                    </StackPanel>

                    <Border Height="1" Background="{ThemeResource SentryBorderBrush}" />

                    <StackPanel Spacing="9">
                        <TextBlock Text="HARNESS BASELINE" Style="{StaticResource SentryEyebrowTextStyle}" />
                        <Border Padding="10,9" CornerRadius="10" Background="{ThemeResource SentryNavSelectedBrush}">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Codex" FontWeight="SemiBold" /><TextBlock Text="Primary / local" Style="{StaticResource SentryMonoMetaTextStyle}" /></StackPanel>
                                <Ellipse Grid.Column="1" Width="7" Height="7" Fill="{ThemeResource SentrySuccessBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Border Padding="10,9" CornerRadius="10" BorderBrush="{ThemeResource SentryBorderBrush}" BorderThickness="1">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Claude" FontWeight="SemiBold" /><TextBlock Text="Secondary / local" Style="{StaticResource SentryMonoMetaTextStyle}" /></StackPanel>
                                <TextBlock Grid.Column="1" Text="READY" Style="{StaticResource SentryMonoMetaTextStyle}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Border Padding="10,9" CornerRadius="10" BorderBrush="{ThemeResource SentryBorderBrush}" BorderThickness="1">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Grok Build" FontWeight="SemiBold" /><TextBlock Text="Open-source baseline" Style="{StaticResource SentryMonoMetaTextStyle}" /></StackPanel>
                                <TextBlock Grid.Column="1" Text="AUDIT" Foreground="{ThemeResource SentryWarningBrush}" Style="{StaticResource SentryMonoMetaTextStyle}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <Border Height="1" Background="{ThemeResource SentryBorderBrush}" />

                    <StackPanel Spacing="7">
                        <TextBlock Text="RESOLUTION POLICY" Style="{StaticResource SentryEyebrowTextStyle}" />
                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="During commands" /><TextBlock Grid.Column="1" Text="SILENT" Style="{StaticResource SentryMonoMetaTextStyle}" />
                        </Grid>
                        <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="On resolution" /><TextBlock Grid.Column="1" Text="1 SENTENCE" Foreground="{ThemeResource SentryAccentBrush}" Style="{StaticResource SentryMonoMetaTextStyle}" />
                        </Grid>
                        <ToggleSwitch x:Name="InspectorSpeakToggle" Header="Voice output" Toggled="InspectorSpeakToggle_Toggled" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
