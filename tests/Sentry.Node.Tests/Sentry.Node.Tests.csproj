<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <!-- xUnit v3 on Microsoft Testing Platform: the older VSTest host never
       connected on this machine. Do not revert. -->
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Sentry.Node\Sentry.Node.csproj" />
  </ItemGroup>

  <!-- Linked into the test output so the settings assertions read the real
       shipped file rather than walking a relative source path. -->
  <ItemGroup>
    <None Include="..\..\src\Sentry.Node\Harnesses\claude-automation-settings.json"
          Link="claude-automation-settings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
