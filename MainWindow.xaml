<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="SentryAssistant.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SentryAssistant"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Sentry Assistant"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="{ThemeResource SentryBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Height="48" Padding="14,0,150,0" Background="{ThemeResource SentryRailBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="234" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                <Border Width="26" Height="26" CornerRadius="8" Background="{ThemeResource SentryAccentMutedBrush}">
                    <FontIcon Glyph="&#xE7BA;" FontSize="14" Foreground="{ThemeResource SentryAccentBrush}" />
                </Border>
                <TextBlock Text="SENTRY" Style="{StaticResource SentryEyebrowTextStyle}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="Personal operations console" VerticalAlignment="Center"
                       Foreground="{ThemeResource SentryTextMutedBrush}" FontSize="12" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                <Ellipse Width="6" Height="6" Fill="{ThemeResource SentrySuccessBrush}" />
                <TextBlock Text="LOCAL" Style="{StaticResource SentryMonoMetaTextStyle}" />
            </StackPanel>
        </Grid>

        <Frame x:Name="RootFrame" Grid.Row="1" />
    </Grid>
</Window>
