<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Sentry.Node</RootNamespace>
    <!-- The node is a library plus a worker host; tests target the library. -->
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.3.0" />
  </ItemGroup>

  <!-- The automation settings ship next to the binary so the adapter can point
       Claude at them without depending on the source tree layout. -->
  <ItemGroup>
    <None Include="Harnesses\claude-automation-settings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sentry.Contracts\Sentry.Contracts.csproj" />
  </ItemGroup>

</Project>
