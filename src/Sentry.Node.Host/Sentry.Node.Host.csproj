<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Sentry.Node.Host</RootNamespace>
    <AssemblyName>sentry-node</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sentry.Node\Sentry.Node.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="appsettings.node.example.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- The Claude automation settings must sit beside the executable, since the
         adapter resolves them from the binary directory. -->
    <None Include="..\Sentry.Node\Harnesses\claude-automation-settings.json"
          Link="claude-automation-settings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
